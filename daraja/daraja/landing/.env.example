# Copy to .env for local work. Only PUBLIC_ values are ever sent to the browser,
# so never put a secret in this file.

# Public address of this site (used for canonical URLs and the sitemap).
PUBLIC_SITE_URL=https://daraja.co.ke

# Address of the Flutter web app (the client portal).
PUBLIC_APP_URL=https://app.daraja.co.ke

# WhatsApp number in international format, digits only (example: 254700000000).
PUBLIC_WHATSAPP_NUMBER=

# Public contact email shown on the Contact page.
PUBLIC_CONTACT_EMAIL=
