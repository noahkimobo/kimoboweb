---
import type { FaqEntry } from '../data/faq';
import JsonLd from './JsonLd.astro';

interface Props {
  entries: FaqEntry[];
  /** Emit FAQPage structured data for these entries. */
  schema?: boolean;
}

const { entries, schema = false } = Astro.props;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entries.map((entry) => ({
    '@type': 'Question',
    name: entry.question,
    acceptedAnswer: { '@type': 'Answer', text: entry.answer },
  })),
};
---

<div class="faq-list">
  {
    entries.map((entry) => (
      <div class="faq-item">
        <h3>{entry.question}</h3>
        <p class="muted">{entry.answer}</p>
      </div>
    ))
  }
</div>
{schema && <JsonLd data={schemaData} />}
