---
import { CONTACT, NAV, SITE } from '../config/site';
import { services } from '../data/services';
---

<footer class="site-footer">
  <div class="container">
    <div>
      <p class="footer-brand">{SITE.name}</p>
      <p>{SITE.tagline}.</p>
    </div>
    <nav aria-label="Services">
      <p class="footer-title">Services</p>
      <ul class="footer-list">
        {
          services.map((service) => (
            <li>
              <a href={`/services/${service.slug}/`}>{service.shortTitle}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Company">
      <p class="footer-title">Company</p>
      <ul class="footer-list">
        {
          NAV.filter((item) => item.href !== '/services/').map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href="/contact/">Contact</a></li>
        <li><a href={SITE.appUrl} rel="noopener">Client login</a></li>
      </ul>
    </nav>
    <div>
      <p class="footer-title">Reach us</p>
      <ul class="footer-list">
        {CONTACT.whatsappUrl && <li><a href={CONTACT.whatsappUrl} rel="noopener noreferrer">WhatsApp</a></li>}
        {CONTACT.emailUrl && <li><a href={CONTACT.emailUrl}>{CONTACT.email}</a></li>}
        <li>{SITE.city}, {SITE.country}</li>
      </ul>
    </div>
  </div>
</footer>
