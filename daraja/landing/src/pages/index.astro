---
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import Testimonials from '../components/Testimonials.astro';
import { CTA_LABEL } from '../config/site';
import { withBase } from '../config/paths';
import { homeFaq } from '../data/faq';
import { services } from '../data/services';
import { offeringGroups } from '../data/offerings';
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    num: '1',
    title: 'Assess',
    body: 'We read your numbers and your channels before proposing anything.',
  },
  {
    num: '2',
    title: 'Build',
    body: 'Storefront, brand and payments for new sellers. Content and ad engine for existing ones.',
  },
  {
    num: '3',
    title: 'Grow',
    body: 'Ads and content keep running, and we adjust them from what your audience actually does.',
  },
];
---

<BaseLayout
  title="Take your business online in Nairobi"
  description="Daraja moves Nairobi businesses online and grows the ones already there: valuation, M-Pesa storefronts, brand design and TikTok, Instagram and Facebook ads."
  organization
>
  <div class="container hero">
    <div class="stack stack--28">
      <p class="eyebrow">Nairobi - Online migration and social media growth</p>
      <h1 class="h1">The bridge between your business and the online market.</h1>
      <p class="lead">
        Daraja moves Nairobi businesses online and grows the ones already there. Storefront, M-Pesa
        payments and social media, handled by one team.
      </p>
      <div class="hero-actions">
        <a class="btn btn--primary btn--audit" href={withBase('/social-media-health-check.html')}>
          Free social media self-audit
        </a>
        <a class="btn btn--primary" href={withBase('/contact/')}>{CTA_LABEL}</a>
        <a class="text-link" href={withBase('/services/')}>See what we do</a>
      </div>
    </div>
    <div
      class="hero-art"
      role="img"
      aria-label="Social media ideas crossing an amber bridge into online business growth."
    >
      <div class="social-card social-card--reach">
        <span class="social-mark social-mark--reach" aria-hidden="true">▶</span>
        <strong>#viral</strong>
        <span class="social-metric">+2.4K views</span>
      </div>
      <div class="social-card social-card--brand">
        <span class="social-mark social-mark--brand" aria-hidden="true">@</span>
        <strong>@daraja</strong>
        <span class="social-metric">Your brand</span>
      </div>
      <div class="social-card social-card--local">
        <span class="social-mark social-mark--local" aria-hidden="true">↗</span>
        <strong>#Nairobi</strong>
        <span class="social-metric">Find your people</span>
      </div>
      <div class="social-card social-card--growth">
        <span class="social-mark social-mark--growth" aria-hidden="true">▥</span>
        <strong>+38%</strong>
        <span class="social-metric">More enquiries</span>
      </div>
      <svg class="bridge-arch" viewBox="0 0 520 320" aria-hidden="true" focusable="false">
        <path d="M58 288C94 88 166 48 260 48s166 40 202 240" />
      </svg>
      <div class="bridge-deck" aria-hidden="true"></div>
      <div class="bridge-foundations" aria-hidden="true">
        <span class="bridge-foundation bridge-foundation--shop"></span>
        <span class="bridge-foundation bridge-foundation--growth"></span>
      </div>
    </div>
  </div>

  <section class="section" aria-labelledby="paths-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="paths-title">Two starting points, one company</h2>
        <p class="muted">
          The commerce side moves you online. The social media agency keeps you seen once you are there.
        </p>
      </div>
      <div class="grid grid--2">
        <article class="card path-card" aria-labelledby="migrate-title">
          <p class="kicker">Not online yet</p>
          <h3 class="h3" id="migrate-title">Move your business online</h3>
          <p class="muted">
            Get a clearer picture of your stock and sales, then plan an online setup around your business.
          </p>
          <ul class="check-list">
            <li>Value your inventory and read your bank and M-Pesa history</li>
            <li>Move to a warehouse delivery model with far less physical overhead</li>
            <li>Launch a storefront that takes M-Pesa payments automatically</li>
          </ul>
          <a class="path-card-link" href={withBase('/services/valuation-and-migration/')}>
            Explore valuation and migration<span aria-hidden="true">→</span>
          </a>
        </article>
        <article class="card card--dark path-card" aria-labelledby="grow-title">
          <p class="kicker">Already online</p>
          <h3 class="h3" id="grow-title">Turn social activity into growth</h3>
          <p class="muted">
            If you are posting but unsure what is working, start by checking your profiles and content.
          </p>
          <ul class="check-list">
            <li>Audit your TikTok, Instagram and Facebook channels</li>
            <li>Scripts and FAQ videos written around your business</li>
            <li>Targeted Meta and TikTok ads, run for you</li>
          </ul>
          <a class="path-card-link" href={withBase('/social-media-health-check.html')}>
            Take the free social media self-audit<span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="services-title">What we do</h2>
        <p class="muted">
          Digital growth, search, websites, content and creative campaigns, alongside hands-on support to move your business online.
        </p>
      </div>
      <div class="offering-groups-home">
        {
          offeringGroups.map((group) => (
            <article class="card offering-home-card">
              <p class="kicker">{group.title}</p>
              <h3 class="h3">{group.title}</h3>
              <p class="muted">{group.summary}</p>
              <ul class="offering-home-list">
                {group.offerings.map((offering) => (
                  <li>
                    <a href={withBase(`/services/${offering.slug}/`)}>
                      {offering.title}<span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <h3 class="h3 core-services-home-title">End-to-end business services</h3>
      <div class="service-grid">
        {
          services.map((service) => (
            <article class="service-row">
              <h3 class="h3">
                <span class="num">{service.num}</span>
                {service.title}
              </h3>
              <div class="stack stack--16">
                <p class="muted">{service.summary}</p>
                <a class="text-link" href={withBase(`/services/${service.slug}/`)}>
                  Learn more<span class="visually-hidden"> about {service.shortTitle}</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="process-title">How we work</h2>
      </div>
      <div class="grid grid--3">
        {
          steps.map((step) => (
            <div class="process-card">
              <p class="big" aria-hidden="true">{step.num}</p>
              <h3 class="h3">{step.title}</h3>
              <p>{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="faq-group">
        <div class="section-head">
          <h2 class="h2" id="faq-title">Questions business owners ask</h2>
          <a class="text-link" href={withBase('/faq/')}>Read all questions</a>
        </div>
        <FaqList entries={homeFaq} schema />
      </div>
    </div>
  </section>

  <CtaBand heading="Tell us where your business is today." />
</BaseLayout>
