---
import type { GetStaticPaths } from 'astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import JsonLd from '../../components/JsonLd.astro';
import { createWhatsAppUrl, SITE } from '../../config/site';
import { withBase } from '../../config/paths';
import { getOffering, offeringGroups } from '../../data/offerings';
import { getService, relatedServices, services } from '../../data/services';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() =>
  [
    ...services.map((service) => ({ params: { slug: service.slug } })),
    ...offeringGroups.flatMap((group) =>
      group.offerings.map((offering) => ({ params: { slug: offering.slug } })),
    ),
  ]) satisfies GetStaticPaths;

const slug = Astro.params.slug ?? '';
const offeringPage = getOffering(slug);
const service = offeringPage ? undefined : getService(slug);
const title = offeringPage?.offering.title ?? service?.title ?? '';
const description = offeringPage?.offering.summary ?? service?.metaDescription ?? '';
const category = offeringPage?.group.title;
const contactMessage = `Hello Daraja, I would like to discuss ${title}. What would be a good next step?`;
const serviceWhatsAppUrl = createWhatsAppUrl(contactMessage);
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: title,
  description,
  provider: { '@type': 'ProfessionalService', name: SITE.name, url: SITE.url },
  areaServed: { '@type': 'City', name: SITE.city },
};
---

<BaseLayout title={title} description={description}>
  <div class="container page-hero">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href={withBase('/')}>Home</a></li>
        <li><a href={withBase('/services/')}>Services</a></li>
        {category && <li><a href={withBase(`/services/#${offeringPage?.group.slug}`)}>{category}</a></li>}
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    {category && <p class="kicker">{category}</p>}
    <h1 class="h1">{title}</h1>
    <p class="lead">{offeringPage?.offering.intro ?? service?.intro}</p>
    <div class="service-hero-action">
      <a
        class="btn btn--primary"
        href={serviceWhatsAppUrl ?? withBase('/contact/')}
        rel={serviceWhatsAppUrl ? 'noopener noreferrer' : undefined}
      >
        Discuss this service
      </a>
      <p class="muted">We’ll learn about your goals and agree a scope before work begins.</p>
    </div>
  </div>

  {
    offeringPage ? (
      <>
        {offeringPage.offering.showcase && (
          <section class="section" aria-labelledby="analytics-title">
            <div class="container">
              <div class="section-head">
                <h2 class="h2" id="analytics-title">{offeringPage.offering.showcase.heading}</h2>
                <p class="muted">{offeringPage.offering.showcase.description}</p>
              </div>
              <ul class="analytics-gallery" aria-label="Social media analytics screenshots">
                {offeringPage.offering.showcase.images.map((image) => (
                  <li class="analytics-card">
                    <figure>
                      <img
                        src={withBase(image.src)}
                        alt={image.alt}
                        width="768"
                        height="1536"
                        loading="lazy"
                        decoding="async"
                      />
                      <figcaption>{image.caption}</figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
        <section class="section" aria-labelledby="includes-title">
          <div class="container">
            <div class="section-head">
              <h2 class="h2" id="includes-title">How we can help</h2>
              <p class="muted">{offeringPage.offering.summary}</p>
            </div>
            <ul class="grid grid--3 offering-detail-list">
              {offeringPage.offering.includes.map((item, index) => (
                <li class="card card--compact">
                  <span class="kicker">0{index + 1}</span>
                  <p>{item}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="section" aria-labelledby="fit-title">
          <div class="container offering-detail-fit">
            <div class="stack stack--16">
              <p class="kicker">A practical starting point</p>
              <h2 class="h2" id="fit-title">Who this service is for</h2>
              <p class="muted">
                Every business starts from a different place. We’ll learn about your goals and agree a scope
                before recommending any work.
              </p>
            </div>
            <ul class="check-list">
              {offeringPage.offering.goodFitFor.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </section>

        <section class="section--tight" aria-labelledby="related-title">
          <div class="container stack stack--24">
            <h2 class="h2" id="related-title">Explore more in {category}</h2>
            <ul class="grid grid--3">
              {offeringPage.group.offerings
                .filter((other) => other.slug !== offeringPage.offering.slug)
                .slice(0, 3)
                .map((other) => (
                  <li>
                    <a class="card card--mist card--compact" href={withBase(`/services/${other.slug}/`)}>
                      <span class="h3">{other.title}</span>
                      <span class="muted">{other.summary}</span>
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        </section>
        <CtaBand
          heading={`Let’s talk about ${offeringPage.offering.title.toLowerCase()}.`}
          whatsappMessage={contactMessage}
        />
      </>
    ) : service ? (
      <>
        <section class="section" aria-labelledby="gets-title">
          <div class="container">
            <div class="section-head">
              <h2 class="h2" id="gets-title">What you get</h2>
            </div>
            <div class="grid grid--wide">
              {service.items.map((item) => (
                <div class="card card--compact">
                  <h3 class="h3">{item.title}</h3>
                  <p class="muted">{item.body}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="how-title">
          <div class="container">
            <div class="band">
              <div class="section-head">
                <h2 class="h2" id="how-title">How it works</h2>
              </div>
              <ol class="steps">
                {service.steps.map((step, index) => (
                  <li class="step">
                    <p class="step-num">Step {index + 1}</p>
                    <h3 class="h3">{step.title}</h3>
                    <p>{step.body}</p>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </section>

        <section class="section" aria-label="Who it is for and common questions">
          <div class="container faq-group">
            <div class="stack stack--24">
              <h2 class="h2">Who it is for</h2>
              <ul class="check-list">
                {service.who.map((line) => <li>{line}</li>)}
              </ul>
            </div>
            <div class="stack stack--24">
              <h2 class="h2">Questions owners ask</h2>
              <FaqList entries={service.faq.map((f) => ({ question: f.question, answer: f.answer }))} schema />
            </div>
          </div>
        </section>

        <section class="section--tight" aria-labelledby="other-title">
          <div class="container stack stack--24">
            <h2 class="h2" id="other-title">Other services</h2>
            <ul class="grid grid--3">
              {relatedServices(service.slug).map((other) => (
                <li>
                  <a class="card card--mist card--compact" href={withBase(`/services/${other.slug}/`)}>
                    <span class="kicker">{other.num}</span>
                    <span class="h3">{other.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <CtaBand heading={service.closing} whatsappMessage={contactMessage} />
      </>
    ) : null
  }
  <JsonLd data={pageSchema} />
</BaseLayout>
