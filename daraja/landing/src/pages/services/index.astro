---
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../data/services';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services"
  description="Business valuation and hybrid migration, brand and graphic design, M-Pesa storefronts and POS apps, and TikTok, Instagram and Facebook ads for Nairobi businesses."
>
  <div class="container page-hero">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-current="page">Services</li>
      </ol>
    </nav>
    <h1 class="h1">Everything it takes to get online, and to keep growing once you are.</h1>
    <p class="lead">
      Four services you can take alone or together. Each one has its own page with what you get, how it works and
      the questions owners ask us.
    </p>
  </div>

  <section class="section" aria-label="All services">
    <div class="container">
      {
        services.map((service) => (
          <article class="service-row">
            <h2 class="h2">
              <span class="num">{service.num}</span>
              {service.title}
            </h2>
            <div class="stack stack--24">
              <p class="muted">{service.summary}</p>
              <ul class="dot-list">
                {service.points.map((point) => <li>{point}</li>)}
              </ul>
              <a class="text-link" href={`/services/${service.slug}/`}>
                Read about this service<span class="visually-hidden">: {service.shortTitle}</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand heading="Not sure which one you need first?" />
</BaseLayout>
