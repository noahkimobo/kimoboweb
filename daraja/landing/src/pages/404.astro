---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist. Go back to the Daraja home page." noindex>
  <div class="container page-hero stack stack--24">
    <h1 class="h1">That page is not here.</h1>
    <p class="lead">The link may be old or mistyped. Start again from the home page.</p>
    <a class="btn btn--primary" href="/">Back to home</a>
  </div>
</BaseLayout>
