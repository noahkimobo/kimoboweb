---
import { CONTACT, createWhatsAppUrl, CTA_LABEL } from '../config/site';
import { withBase } from '../config/paths';

interface Props {
  heading: string;
  whatsappMessage?: string;
}

const { heading, whatsappMessage } = Astro.props;

// Prefer a direct WhatsApp chat when a number is configured.
const whatsappHref = whatsappMessage
  ? createWhatsAppUrl(whatsappMessage)
  : CONTACT.whatsappUrl;
const external = whatsappHref !== null;
const href = whatsappHref ?? withBase('/contact/');
const label = external
  ? whatsappMessage
    ? 'Discuss this service on WhatsApp'
    : 'Message us on WhatsApp'
  : CTA_LABEL;
---

<section class="section--tight">
  <div class="container">
    <div class="cta-band">
      <h2 class="h2">{heading}</h2>
      <a class="btn" href={href} rel={external ? 'noopener noreferrer' : undefined}>{label}</a>
    </div>
  </div>
</section>
