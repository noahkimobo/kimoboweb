---
import { CTA_LABEL, NAV, SITE } from '../config/site';
import { withBase, withoutBase } from '../config/paths';
import Logo from './Logo.astro';
import { offeringGroups } from '../data/offerings';

const path = withoutBase(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={withBase('/')} aria-label={`${SITE.name} home`}>
      <Logo />
      {SITE.name}
    </a>
    <nav class="nav" aria-label="Main">
      <details class="nav-services">
        <summary aria-current={path.startsWith('/services/') ? 'page' : undefined}>
          Services <span class="nav-caret" aria-hidden="true"></span>
        </summary>
        <div class="nav-services-menu">
          <a class="nav-services-all" href={withBase('/services/')}>Explore all services</a>
          <div class="nav-services-groups">
            {
              offeringGroups.map((group) => (
                <section aria-label={group.title}>
                  <p class="nav-services-title">{group.title}</p>
                  <ul>
                    {group.offerings.map((offering) => (
                      <li>
                        <a href={withBase(`/services/#${offering.slug}`)}>{offering.title}</a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </div>
        </div>
      </details>
      {
        NAV.filter((item) => item.href !== '/services/').map((item) => (
          <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="btn btn--primary btn--small" href={withBase('/contact/')}>{CTA_LABEL}</a>
    </nav>
  </div>
</header>
